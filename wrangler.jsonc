// Publicación web en Cloudflare (Workers con archivos estáticos).
// Cloudflare ejecuta `npm run build:web` y luego `npx wrangler deploy`,
// que sube dist/ tal cual; _redirects resuelve las rutas dinámicas.
{
  "name": "app-legal-peru",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
